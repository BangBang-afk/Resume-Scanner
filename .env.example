# ShortlistIQ environment template — copy to .env and fill in what you need.
# Everything except DATABASE_URL has a working default; the app runs end-to-end
# with LLM_PROVIDER=none (rule-based extractor, no API keys required).

# --- Database (required for docker compose; defaults to sqlite when unset) ---
DATABASE_URL=postgresql+psycopg://shortlistiq:shortlistiq@db:5432/shortlistiq

# --- LLM extractor ---
# One of: gemini | anthropic | groq | none
# "none" uses the deterministic rule-based extractor; no API key needed.
LLM_PROVIDER=none

# Required only for the matching provider (leave blank otherwise):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Model overrides (optional; sensible defaults are baked in)
GEMINI_MODEL=gemini-2.0-flash

# Sentence-transformers model used for fuzzy skill matching + duplicate detection.
# First run downloads it from Hugging Face (~130 MB for the default).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Frontend ---
# Browser-facing API base URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend hardening ---
# Comma-separated CORS allow-list for browser origins. Add your deployed
# frontend origin here before going live.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max requests per client IP per 60s window (health endpoint exempt).
RATE_MAX=600

# --- Recruiter auth (optional features) ---
# HMAC secret for session tokens. Leave unset + single node = auto-generated at
# boot (sign-ins reset on restart). Set a stable value when running multiple
# workers/replicas. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
# AUTH_SECRET=
# Session lifetime in seconds (default 12h).
# TOKEN_TTL_SECONDS=43200
# Days to keep raw (unmasked) resume text before it is zeroed out; masked text
# and scores are kept (PURGE_RAW_TEXT_AFTER_DAYS=0 keeps forever).
# PURGE_RAW_TEXT_AFTER_DAYS=30
